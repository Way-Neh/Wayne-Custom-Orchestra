{
  "$schema": "./orchestrator_mode.schema.json",
  "activeMode": "Wayne Custom 2.0 2026-10-16",
  "modes": {
    "Wayne Custom 2.0 2026-10-16": {
      "description": "Adaptive multi-agent swarm integrating Kye Gomez Swarms topologies (Hierarchical Swarm, LLM Council / Consensus, Swarm Router, Mixture of Agents, Bounded Cyclic Self-Healing), dynamic task sizing (S_task), criteria-mapped adversarial QA, machine blackboard contracts, and zero direct labor for Tier 3.",
      "rosterPath": ".agents/roster",
      "agentRoster": {
        "pm-agent": ".agents/roster/pm-agent/AGENTS.md",
        "design-agent": ".agents/roster/design-agent/AGENTS.md",
        "architect-agent": ".agents/roster/architect-agent/AGENTS.md",
        "builder-agent": ".agents/roster/builder-agent/AGENTS.md",
        "qa-adversary-agent": ".agents/roster/qa-adversary-agent/AGENTS.md",
        "seo-agent": ".agents/roster/seo-agent/AGENTS.md",
        "analytics-agent": ".agents/roster/analytics-agent/AGENTS.md",
        "image-agent": ".agents/roster/image-agent/AGENTS.md",
        "docs-agent": ".agents/roster/docs-agent/AGENTS.md"
      },
      "taskSizing": {
        "tier1": "Direct Solo (S_task <= 5)",
        "tier2": "Targeted Specialist (S_task 6-8)",
        "tier3": "Full Swarm (S_task >= 9)"
      },
      "zeroDirectLaborTier3": true,
      "approvalGate": {
        "interactive": true,
        "scheduled": false
      },
      "blackboardEnabled": true,
      "swarmTopologies": [
        "Hierarchical Swarm",
        "LLM Council / Consensus",
        "Swarm Router",
        "Mixture of Agents (MoA)",
        "Cyclic Self-Healing"
      ],
      "cyclicSelfHealing": {
        "enabled": true,
        "maxIterations": 3
      },
      "concurrentWorkerWorktrees": {
        "enabled": true,
        "worktreeDirectory": ".worktrees",
        "branchPrefix": "swarm/worker-",
        "autoCleanupOnPass": true
      },
      "telemetry": {
        "reportTokensAndModel": true,
        "collatedTable": true
      },
      "corePillars": [
        "The Orchestrator",
        "pm-agent",
        "design-agent",
        "architect-agent",
        "builder-agent",
        "qa-adversary-agent"
      ],
      "dynamicPlugins": [
        "seo-agent",
        "analytics-agent",
        "image-agent",
        "docs-agent"
      ],
      "agentSkillBoundaries": {
        "The Orchestrator": {
          "assignedSkills": [
            "dispatching-parallel-agents",
            "brainstorming"
          ],
          "excludedSkills": [
            "all direct implementation",
            "UI styling",
            "code editing"
          ]
        },
        "pm-agent": {
          "assignedSkills": [
            "writing-plans",
            "brainstorming"
          ],
          "excludedSkills": [
            "code editing",
            "UI styling",
            "debugging"
          ]
        },
        "design-agent": {
          "assignedSkills": [
            "impeccable",
            "design-system",
            "ui-ux-pro-max (query-only)"
          ],
          "excludedSkills": [
            "animate",
            "animate-expo",
            "emil-design-eng",
            "ui-styling",
            "code implementation",
            "brand",
            "slides",
            "banner-design"
          ]
        },
        "architect-agent": {
          "assignedSkills": [
            "architecture & schema design",
            "api contracts"
          ],
          "excludedSkills": [
            "frontend CSS",
            "UI styling",
            "browser test tools"
          ]
        },
        "builder-agent": {
          "assignedSkills": [
            "ui-styling",
            "modern-web-guidance",
            "animate",
            "systematic-debugging"
          ],
          "excludedSkills": [
            "brand",
            "slides",
            "canvas-design",
            "open-ended design discovery"
          ]
        },
        "qa-adversary-agent": {
          "assignedSkills": [
            "a11y-debugging",
            "chrome-devtools",
            "verification-before-completion",
            "impeccable detect (anti-slop audit)"
          ],
          "excludedSkills": [
            "file writing",
            "creative design",
            "feature implementation"
          ]
        },
        "seo-agent": {
          "assignedSkills": [
            "search console",
            "metadata validators",
            "json-ld"
          ],
          "excludedSkills": [
            "UI layout",
            "CSS",
            "backend database"
          ]
        },
        "analytics-agent": {
          "assignedSkills": [
            "GA4 api",
            "sql adapters",
            "event taxonomy"
          ],
          "excludedSkills": [
            "visual design",
            "application code"
          ]
        },
        "image-agent": {
          "assignedSkills": [
            "search_web",
            "generate_image",
            "banner-design",
            "brand (visual assets)",
            "canvas-design"
          ],
          "excludedSkills": [
            "code editing",
            "refactoring"
          ]
        },
        "docs-agent": {
          "assignedSkills": [
            "markdown documentation",
            "api markdown"
          ],
          "excludedSkills": [
            "heavy runtime skills",
            "execution tools"
          ]
        }
      }
    },
    "Direct Solo": {
      "description": "Direct single-agent pair programming mode without subagent overhead.",
      "zeroDirectLabor": false,
      "approvalGate": {
        "interactive": false,
        "scheduled": false
      },
      "blackboardEnabled": false,
      "subagents": []
    },
    "TDD Pair": {
      "description": "Strict Test-Driven Development pairing mode (Red-Green-Refactor).",
      "zeroDirectLabor": false,
      "approvalGate": {
        "interactive": true,
        "scheduled": false
      },
      "blackboardEnabled": false,
      "subagents": ["qa-adversary-agent"]
    }
  }
}
