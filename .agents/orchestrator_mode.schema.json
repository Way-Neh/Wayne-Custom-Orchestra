{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrchestratorModeConfig",
  "type": "object",
  "properties": {
    "activeMode": {
      "type": "string",
      "description": "The active orchestrator mode for this workspace."
    },
    "modes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "zeroDirectLabor": { "type": "boolean" },
          "approvalGate": {
            "type": "object",
            "properties": {
              "interactive": { "type": "boolean" },
              "scheduled": { "type": "boolean" }
            }
          },
          "blackboardEnabled": { "type": "boolean" },
          "subagents": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "required": ["activeMode"]
}
