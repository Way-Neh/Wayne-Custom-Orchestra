{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrchestratorModeConfig",
  "type": "object",
  "properties": {
    "activeMode": {
      "type": "string",
      "description": "The active orchestrator mode for this workspace."
    },
    "modes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "taskSizing": {
            "type": "object",
            "properties": {
              "tier1": { "type": "string" },
              "tier2": { "type": "string" },
              "tier3": { "type": "string" }
            }
          },
          "zeroDirectLabor": { "type": "boolean" },
          "zeroDirectLaborTier3": { "type": "boolean" },
          "approvalGate": {
            "type": "object",
            "properties": {
              "interactive": { "type": "boolean" },
              "scheduled": { "type": "boolean" }
            }
          },
          "blackboardEnabled": { "type": "boolean" },
          "swarmTopologies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "cyclicSelfHealing": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "maxIterations": { "type": "integer" }
            }
          },
          "corePillars": {
            "type": "array",
            "items": { "type": "string" }
          },
          "dynamicPlugins": {
            "type": "array",
            "items": { "type": "string" }
          },
          "agentSkillBoundaries": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "assignedSkills": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "excludedSkills": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["assignedSkills", "excludedSkills"]
            }
          },
          "subagents": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "required": ["activeMode"]
}
